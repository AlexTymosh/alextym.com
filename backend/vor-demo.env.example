# Fleet VOR Hub backend-only environment example. Do not commit actual secrets.
VOR_DEMO_ENABLED=true
VOR_DEMO_PASSWORD=CHANGE_ME_BEFORE_PUBLIC_LIVE_SEND
VOR_DEMO_SEND_REAL_EMAIL=false
VOR_DEMO_EMAIL_LIMIT=15
VOR_DEMO_PUBLIC_URL=https://alextym.com/fleet-vor-hub
VOR_DEMO_ALLOWED_ORIGINS=https://alextym.com,https://www.alextym.com
# Use * to permit any domain (still restricted to contacts subscribed in Manage).
# This is not recommended for a public demo with a weak password.
VOR_DEMO_ALLOWED_EMAIL_DOMAINS=scas.nhs.uk
VOR_DEMO_ALLOWED_RECIPIENTS=
VOR_DEMO_FROM_EMAIL=
RESEND_API_KEY=
# Use only with attached persistent volume/disk when deployed:
VOR_DEMO_DB_PATH=/var/data/vor_hub.sqlite3
