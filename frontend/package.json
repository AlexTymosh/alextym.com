{
  "name": "alextym-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/link-portfolio-deps.mjs && npm run sync:project-config",
    "build": "next build",
    "prebuild": "node scripts/link-portfolio-deps.mjs && npm run sync:project-config",
    "start": "next start",
    "lint": "eslint . && node scripts/lint-fleet-module.mjs",
    "prelint": "node scripts/link-portfolio-deps.mjs && npm run sync:project-config",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "node scripts/link-portfolio-deps.mjs && npm run sync:project-config",
    "check:resume": "node scripts/check-resume-parser.mjs",
    "precheck:resume": "npm run sync:project-config",
    "e2e": "playwright test",
    "pree2e": "node scripts/link-portfolio-deps.mjs && npm run sync:project-config",
    "e2e:headed": "playwright test --headed",
    "pree2e:headed": "node scripts/link-portfolio-deps.mjs && npm run sync:project-config",
    "e2e:install": "playwright install chromium",
    "sync:project-config": "node scripts/sync-project-config.mjs"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
